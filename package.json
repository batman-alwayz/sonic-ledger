{
  "name": "sonic-ledger",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:worker": "node --watch src/worker/poller.js",
    "dev:all": "concurrently -n api,worker -c blue,green \"npm:dev\" \"npm:dev:worker\"",
    "start": "node src/index.js",
    "worker": "node src/worker/poller.js",
    "contest": "node src/worker/contest.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
