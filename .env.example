# WEB_ORIGIN now equals PUBLIC_URL: the website is served by this same server
# (see public/), not by a separate frontend process on another port.
PORT=8080
PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://sonic:sonic@localhost:5432/sonic
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_me_32_bytes
TOKEN_ENC_KEY=replace_with_32_byte_base64
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT=http://localhost:8080/auth/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8080/auth/google/callback
POLL_PLAYING_MS=1000
POLL_PAUSED_MS=2500
POLL_IDLE_MS=8000
